{
  "name": "nisos",
  "private": true,
  "version": "0.1.0",
  "description": "Nisos - Cyprus super-app prototype (digital identity, government services, payments, personal finance)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix server start",
    "demo": "concurrently -n frontend,backend -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
